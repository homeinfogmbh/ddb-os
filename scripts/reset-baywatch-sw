#! /usr/bin/env python3
"""Reset Chromium's service worker storage when the Baywatch extension changed.

Baywatch is loaded with --load-extension. For such extensions Chromium keeps
running the service worker script it registered first and does not pick up a
new service-worker.js after a package update; content scripts are read from
disk, the service worker is not. Remove the profile's service worker storage
whenever the installed extension version differs from the one seen last time,
so that Chromium registers the current script on its next start.

Run as the kiosk user before Chromium starts.
"""

from json import load
from logging import INFO, basicConfig, getLogger
from pathlib import Path
from shutil import rmtree


MANIFEST = Path('/usr/share/digital-signage/baywatch/manifest.json')
PROFILE = Path.home() / '.config' / 'chromium' / 'Default'
SERVICE_WORKER_DIR = PROFILE / 'Service Worker'
STAMP = PROFILE / '.baywatch-version'
LOGGER = getLogger('reset-baywatch-sw')


def get_installed_version() -> str:
    """Return the version of the installed extension."""

    with MANIFEST.open('r', encoding='utf-8') as file:
        return load(file)['version']


def get_seen_version() -> str | None:
    """Return the extension version seen on the last start."""

    try:
        return STAMP.read_text(encoding='utf-8').strip()
    except FileNotFoundError:
        return None


def main() -> None:
    """Run the script."""

    basicConfig(level=INFO, format='%(name)s: %(message)s')

    if not PROFILE.is_dir():
        LOGGER.info('No Chromium profile yet, nothing to reset.')
        return

    installed = get_installed_version()

    if (seen := get_seen_version()) == installed:
        return

    LOGGER.info(
        'Baywatch version changed (%s -> %s), resetting service workers.',
        seen, installed
    )
    rmtree(SERVICE_WORKER_DIR, ignore_errors=True)
    STAMP.write_text(installed + '\n', encoding='utf-8')


if __name__ == '__main__':
    main()
